POSTGRES_DB=rulearena
POSTGRES_ADMIN_USER=rulearena_admin
POSTGRES_ADMIN_PASSWORD=replace-local-admin-password
CONTROL_DB_PASSWORD=replace-local-control-password
SANDBOX_DB_PASSWORD=replace-local-sandbox-password
# Local app processes connect through the non-conflicting host mappings below.
CONTROL_DATABASE_URL=postgresql+asyncpg://rulearena_control:replace-local-control-password@127.0.0.1:15432/rulearena
SANDBOX_DATABASE_URL=postgresql+asyncpg://rulearena_sandbox:replace-local-sandbox-password@127.0.0.1:15432/rulearena
REDIS_URL=redis://127.0.0.1:16379/0
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO
# Optional for Control compilation; required to start attack-worker.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# Some gateways (OpenCode Go) reject requests that omit a client-supplied session
# header; the adapter then sends a stable per-conversation id under this name.
LLM_SESSION_HEADER=
# Some gateways (OpenCode Go) reject the json_schema response_format type. The
# schema also travels in the system prompt and caller-side validation is the
# enforced boundary, so `off` costs provider-side enforcement only.
LLM_RESPONSE_FORMAT=on
# Per-million-token prices used to report per-run cost; leave 0 to report no cost.
LLM_INPUT_COST_PER_MTOKEN=0
LLM_OUTPUT_COST_PER_MTOKEN=0
# Completion allowance per proposal call. Reasoning models bill their chain of thought
# as completion tokens, so this must not be throttled by the remaining run budget: a
# throttled call returns empty content at full price and forces a retry.
LLM_MAX_OUTPUT_TOKENS=8192
