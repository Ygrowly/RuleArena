POSTGRES_DB=rulearena
POSTGRES_ADMIN_USER=rulearena_admin
POSTGRES_ADMIN_PASSWORD=replace-local-admin-password
CONTROL_DB_PASSWORD=replace-local-control-password
SANDBOX_DB_PASSWORD=replace-local-sandbox-password
# Local app processes connect through the non-conflicting host mappings below.
CONTROL_DATABASE_URL=postgresql+asyncpg://rulearena_control:replace-local-control-password@127.0.0.1:15432/rulearena
SANDBOX_DATABASE_URL=postgresql+asyncpg://rulearena_sandbox:replace-local-sandbox-password@127.0.0.1:15432/rulearena
REDIS_URL=redis://127.0.0.1:16379/0
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO
