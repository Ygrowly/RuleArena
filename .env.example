POSTGRES_DB=rulearena
POSTGRES_ADMIN_USER=rulearena_admin
POSTGRES_ADMIN_PASSWORD=replace-local-admin-password
CONTROL_DB_PASSWORD=replace-local-control-password
SANDBOX_DB_PASSWORD=replace-local-sandbox-password
CONTROL_DATABASE_URL=postgresql+asyncpg://rulearena_control:replace-local-control-password@postgres:5432/rulearena
SANDBOX_DATABASE_URL=postgresql+asyncpg://rulearena_sandbox:replace-local-sandbox-password@postgres:5432/rulearena
REDIS_URL=redis://redis:6379/0
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO

